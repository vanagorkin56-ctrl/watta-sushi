# Copy to .env.local. Never commit secrets.
APP_URL=http://localhost:3000
DATABASE_PATH=data/watta.sqlite

# Stripe sandbox keys. Live is deliberately disabled until approved.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_LIVE_APPROVED=false

# Server-only Mapbox token with Geocoding v6 and Directions access.
MAPBOX_ACCESS_TOKEN=
# Generate with: openssl rand -hex 32. Keep private and stable across deployments.
DELIVERY_QUOTE_SECRET=

# Confirmation email (verified sender)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=
# Optional owner notification. Leave blank to email customers only.
OWNER_EMAIL=
